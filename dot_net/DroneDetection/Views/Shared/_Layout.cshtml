<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>@ViewData["Title"]</title>

	<!-- Bootstrap does the layout and almost all of the styling -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="https://cdn.datatables.net/2.3.8/css/dataTables.bootstrap5.min.css" rel="stylesheet">
	<!-- Our own CSS: only the card styling -->
	<link href="~/css/site.css" rel="stylesheet">
</head>
<body class="bg-light">
	@* The page content (Views/Home/Index.cshtml) goes here *@
	@RenderBody()

	<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
	<script src="https://cdn.datatables.net/2.3.8/js/dataTables.min.js"></script>
	<script src="https://cdn.datatables.net/2.3.8/js/dataTables.bootstrap5.min.js"></script>
	<!-- Chart.js draws the histogram -->
	<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
	<script src="~/js/site.js"></script>
</body>
</html>